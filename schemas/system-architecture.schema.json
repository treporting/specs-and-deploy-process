{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/treporting/schemas/system-architecture.schema.json",
  "title": "System architecture (r3)",
  "description": "Draft until the gel schema stands (treporting/storage-edgedb#3); field names are the properties of the gel schema.",
  "type": "object",
  "required": [
    "schema",
    "type",
    "level",
    "elements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "schemas/system-architecture.schema.json",
      "description": "the schema of this file, from the root of the repo (formats.md, section Schemas)"
    },
    "type": {
      "const": "architecture",
      "description": "what this file holds (formats.md, section The head of a file)"
    },
    "level": {
      "const": "r3"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "component",
          "status",
          "verification_method",
          "object_version",
          "priority",
          "safety"
        ],
        "additionalProperties": false,
        "attributes_for_version_x": [
          "object_text",
          "safety",
          "component",
          "interface"
        ],
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^ARC_[1-9][0-9]*$"
          },
          "object_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "description": "the subsystem that meets it, by its repo (formats.md, section System architecture)"
          },
          "interface": {
            "type": "string",
            "minLength": 1,
            "description": "the interface it is met over, by its name, where there is one (formats.md, section System architecture)"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(SYS_|ARC[RD]_)[1-9][0-9]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "description": "its uplinks: system requirements, or the rationale or decision of the architecture that made it possible (formats.md, section Ids)"
          },
          "priority": {
            "type": "string"
          },
          "safety": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review"
              ]
            },
            "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "why it stands; required where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
          }
        },
        "anyOf": [
          {
            "required": [
              "source_ids"
            ]
          },
          {
            "required": [
              "rationale"
            ]
          }
        ]
      },
      "description": "the requirements of the architecture on its subsystems and interfaces; each names in component the subsystem that meets it (formats.md, section System architecture)"
    },
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "object_key",
              "object_text",
              "kind",
              "repo",
              "status",
              "verification_method",
              "object_version",
              "priority",
              "safety"
            ],
            "additionalProperties": false,
            "attributes_for_version_x": [
              "object_text",
              "safety"
            ],
            "properties": {
              "object_key": {
                "type": "string",
                "pattern": "^ARC_[1-9][0-9]*$"
              },
              "object_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
              },
              "object_text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "subsystem"
              },
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string"
              },
              "safety": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "review",
                  "approved",
                  "obsolete"
                ]
              },
              "verification_method": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "inspection",
                    "analysis",
                    "demonstration",
                    "test",
                    "review"
                  ]
                },
                "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "why it stands (ISO/IEC/IEEE 29148, 5.2.8)"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "object_key",
              "object_text",
              "kind",
              "between",
              "status",
              "verification_method",
              "object_version",
              "priority",
              "safety"
            ],
            "additionalProperties": false,
            "attributes_for_version_x": [
              "object_text",
              "safety"
            ],
            "properties": {
              "object_key": {
                "type": "string",
                "pattern": "^ARC_[1-9][0-9]$"
              },
              "object_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
              },
              "object_text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "interface"
              },
              "between": {
                "type": "string",
                "minLength": 1
              },
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string"
              },
              "safety": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "review",
                  "approved",
                  "obsolete"
                ]
              },
              "verification_method": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "inspection",
                    "analysis",
                    "demonstration",
                    "test",
                    "review"
                  ]
                },
                "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "why it stands (ISO/IEC/IEEE 29148, 5.2.8)"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "object_key",
              "object_text",
              "kind",
              "contract",
              "status",
              "verification_method",
              "object_version",
              "priority",
              "safety"
            ],
            "additionalProperties": false,
            "attributes_for_version_x": [
              "object_text",
              "safety"
            ],
            "properties": {
              "object_key": {
                "type": "string",
                "pattern": "^ARC_[1-9][0-9]$"
              },
              "object_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
              },
              "object_text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "model"
              },
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string"
              },
              "safety": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "review",
                  "approved",
                  "obsolete"
                ]
              },
              "verification_method": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "inspection",
                    "analysis",
                    "demonstration",
                    "test",
                    "review"
                  ]
                },
                "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "why it stands (ISO/IEC/IEEE 29148, 5.2.8)"
              }
            }
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "object_version",
          "status"
        ],
        "additionalProperties": false,
        "attributes_for_version_x": [
          "object_text"
        ],
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^ARC[RD]_[1-9][0-9]*$"
          },
          "object_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ],
            "description": "as of a requirement; a requirement names it as uplink once it is approved (formats.md, System architecture)"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+/)*[A-Za-z0-9-]+\\.md$"
      },
      "description": "the Markdown files that explain this level, by their path from the root; their versions stand in documents.yaml (formats.md, section Documents)"
    }
  }
}
